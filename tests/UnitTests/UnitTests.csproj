    <Compile Include="../../src/State/RichText.cs" Link="RichText.cs" />
    <Compile Include="../../src/State/CardSpecifier.cs" Link="CardSpecifier.cs" />
    <Compile Include="../../src/State/CollectionSnapshot.cs" Link="CollectionSnapshot.cs" />
    <Compile Include="../../src/State/ContextBoundContent.cs" Link="ContextBoundContent.cs" />
    <Compile Include="../../src/State/ConsumerSemanticRead.cs" Link="ConsumerSemanticRead.cs" />
    <Compile Include="../../src/State/CardPlayability.cs" Link="CardPlayability.cs" />
    <Compile Include="../../src/State/SnapshotContract.cs" Link="SnapshotContract.cs" />
    <Compile Include="../../src/State/DecisionProjection.cs" Link="DecisionProjection.cs" />
    <Compile Include="../../src/State/MerchantRules.cs" Link="MerchantRules.cs" />
    <Compile Include="../../src/State/ErrorEvents.cs" Link="ErrorEvents.cs" />
    <Compile Include="../../src/State/EngineLogCorrelation.cs" Link="EngineLogCorrelation.cs" />
    <Compile Include="../../src/State/EventOptionTracker.cs" Link="EventOptionTracker.cs" />
    <Compile Include="../../src/State/AsyncWorkOwner.cs" Link="AsyncWorkOwner.cs" />
    <Compile Include="../../src/State/FireAndForgetTracker.cs" Link="FireAndForgetTracker.cs" />
    <Compile Include="../../src/State/RunOutcomeRules.cs" Link="RunOutcomeRules.cs" />
    <Compile Include="../../src/State/ProceedReadiness.cs" Link="ProceedReadiness.cs" />
    <Compile Include="../../src/State/RestSiteSeat.cs" Link="RestSiteSeat.cs" />
